# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
#   cp .env.example .env

# Database: SQLite for the course demo, PostgreSQL from the pilot (SDD ADR-13)
SAHTI_DATABASE_URL=sqlite:///./sahti.db
# SAHTI_DATABASE_URL=postgresql://user:password@localhost:5432/sahti

# true only for a public deployment: DRAFT clinical data is then refused (SRS FR-39, NFR-23)
SAHTI_PUBLIC_DEPLOYMENT=false

# Secrets — generate your own, never commit them (SRS SEC-06, SEC-07)
SAHTI_FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key
SAHTI_JWT_SECRET=change-me
